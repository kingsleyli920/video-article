data: {"chapters":[{"id":"1","title":"查询：数据库概念与 SELECT 基础"},{"id":"2","title":"筛选：用 WHERE 设定查询条件"},{"id":"3","title":"排序：用 ORDER BY 整理结果"},{"id":"4","title":"聚合：统计汇总与课程总结"}],"chars":8166,"timing":{"transcriptMs":9,"firstTokenMs":48397,"firstParagraphMs":48908,"modelDoneMs":68940,"reviewedMs":142171,"savedMs":142177},"numberWarnings":[],"model":"gemini-4-hydrogen","review":{"sections":4,"revisions":7,"rewritten":null,"checks":[]}}

