{
  "name": "video-article",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build-client.ts",
    "predev": "tsx scripts/dev-vars.ts",
    "dev": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json && tsc -p tsconfig.node.json",
    "types": "tsx scripts/dev-vars.ts && wrangler types",
    "test:be:unit": "vitest run --project be-unit",
    "test:be:ft": "vitest run --project be-ft",
    "test:e2e:api": "vitest run --project be-e2e",
    "test:fe:unit": "vitest run --project fe-unit",
    "test:fe:ft": "vitest run --project fe-ft",
    "test:e2e:web": "playwright test --project web-mock",
    "test:e2e:ui": "playwright test --project fullstack",
    "test:visual": "playwright test --project visual-desktop --project visual-mobile",
    "test:e2e:live": "playwright test --project live",
    "test:be": "vitest run --project be-unit --project be-ft --project be-e2e",
    "test:fe": "vitest run --project fe-unit --project fe-ft && npm run test:e2e:web",
    "test:fast": "vitest run",
    "test:coverage": "vitest run --coverage --project be-unit --project be-ft --project fe-unit --project fe-ft",
    "test:all": "npm run typecheck && vitest run && playwright test --project web-mock --project fullstack --project visual-desktop --project visual-mobile",
    "transcript:fetch": "tsx scripts/fetch-transcript.ts",
    "cf:verify": "tsx scripts/cf.ts verify",
    "cf:confirm": "tsx scripts/cf.ts confirm",
    "cf:secret:gemini": "tsx scripts/cf.ts secret-gemini",
    "cf:deploy-check": "tsx scripts/cf.ts deploy-check",
    "deploy": "npm run build && tsx scripts/cf.ts wrangler deploy",
    "check:leaks": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run && tsx scripts/check-leaks.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-istanbul": "^4.1.12",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.168.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261123.1": true
  }
}
