# 复制为 .env 后填写。.env 只在本机，已在 .gitignore 里，不提交。

# Cloudflare 个人账户：只给部署工具（scripts/cf.ts）用，不进入前端构建、Worker 运行环境或线上 secrets
CLOUDFLARE_ACCOUNT_ID=
# 个人账户名称（Cloudflare 控制台左上角显示的名称），核对时要求完全一致
CLOUDFLARE_ACCOUNT_NAME=
CLOUDFLARE_API_TOKEN=

# Gemini：应用运行需要。本地按白名单写入 .dev.vars；线上用 npm run cf:secret:gemini 单独写入
GEMINI_API_KEY=

# 可选：覆盖 wrangler.jsonc 里的主模型、备用模型和各自的思考档（下面是线上的默认值）
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_THINKING_LEVEL=high
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_THINKING_LEVEL=low
